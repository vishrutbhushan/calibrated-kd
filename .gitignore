# ==============================================================================
# Calibrated KD: Git Ignore Configuration
# ==============================================================================

# Python bytecode & environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.venv
venv/
ENV/

# Outputs & Experimental Results (Track main_experiments results and figures)
/outputs/*
!/outputs/main_experiments/
/outputs/main_experiments/cache/
/results
/results/
/figures
/figures/
/plots
/plots/
/individual_plots
/individual_plots/
/review
/review/

# Execution Logs
/logs/
*.log
/trash/

# Datasets & Raw Data
/data/
/datasets/

# Models, Checkpoints & Pretrained Weights
/models/
/checkpoints/
*.bin
*.pt
*.safetensors

# Output Image PDFs & LaTeX build artifacts (PNG only for images)
*.pdf
latex/figures/
latex/*.pdf
latex/*.log
latex/*.aux
latex/*.out
latex/*.fls
latex/*.fdb_latexmk
latex/*.synctex.gz

# OS & Editor Files
.DS_Store
.vscode/
.idea/
*:Zone.Identifier
* - Copy.*
~$*
